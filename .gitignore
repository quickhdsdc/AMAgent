###### Project-specific ignores

# Large/ephemeral output directories (any sub-project)
archiv/
basyx/
logs/
ml_models/
poppler-25.07.0/
results_AM/
results/

# Legacy corpus dir — superseded by bibliography/kb_v2 + kb_v3.
# Block re-introduction anywhere in the tree.
corpus_AM/

# bibliography/ contains both shipped corpora (kb_v2, kb_v3) and large
# intermediates (PDFs, raw extractions, DOI caches, bookkeeping CSVs).
# Ship only the final structured-row corpora; ignore everything else.
# (Patterns with internal slashes must be path-anchored; use explicit subprojects.)
AgentApp/bibliography/*
!AgentApp/bibliography/kb_v3/
AgentExperiments/bibliography/*
!AgentExperiments/bibliography/kb_v2/
!AgentExperiments/bibliography/kb_v3/
AgentExperiments/bibliography/kb_v2/_stats.csv

# AgentApp — secrets and local data
AgentApp/config/config.toml
AgentApp/data/
AgentApp/data_binary/
AgentApp/data_clean/
AgentApp/data_exp_binary/
AgentApp/data_exp_lllm_ft/
AgentApp/_archiv/
AgentApp/_scratch/
AgentApp/experiments/

# AgentExperiments — secrets and local data
AgentExperiments/config/config.toml

# AgentFTLLMs — local data, logs, large caches
AgentFTLLMs/data/
AgentFTLLMs/logs/
AgentFTLLMs/.cache/
